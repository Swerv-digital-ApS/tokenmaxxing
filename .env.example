# Server config. Real env vars win over this file (Bun loads .env natively), except the
# RIVET* ones: RivetKit's native side only sees variables set before the process starts.
# PORT=8787
# Where the Rivet engine keeps every actor's state. Mount the Railway volume and point here.
# RIVETKIT_STORAGE_PATH=/data/rivet
# RIVET_LOG_LEVEL=error
# NODE_ENV=production
# Company websites: Firecrawl reads the brand (colours, logo), Claude turns it into house
# colours. Without FIRECRAWL_API_KEY a website only goes on the sign; without
# ANTHROPIC_API_KEY the site's own colours are used as they are.
# FIRECRAWL_API_KEY=fc-...
# ANTHROPIC_API_KEY=sk-ant-...
# The admin page: open /admin#token=<ADMIN_TOKEN> (it's kept in that browser afterwards).
# At least 32 characters: openssl rand -hex 32. Unset, the page lets nobody in.
# ADMIN_TOKEN=
# Per client IP, at the gateway. The IP is read from CLIENT_IP_HEADER (Railway's edge sets x-real-ip).
# CLIENT_IP_HEADER=x-real-ip
# GATEWAY_REQUESTS_PER_MIN=1200
# GATEWAY_SOCKETS_PER_MIN=300

# The outage picnic: claude, openai or both force one (dev, screenshots), off turns it off (a feed gone
# wrong). Unset reads the Claude and OpenAI status pages every 5 minutes. `?picnic=` does the same in one page.
# PICNIC_OUTAGE=claude
# The launch stand: off turns it off (a feed gone wrong). Unset reads OpenRouter's model list every 10 minutes.
# `?launch=grok` (or `?launch=Z AI:GLM 5`, `?launch=off`) forces or hides one in one page.
# LAUNCH_FEED=off
# Dev only: pin the weather the world shows (clear, cloudy, fog, drizzle, rain, storm, snow). Unset fetches Open-Meteo.
# SKY_WEATHER=rain
# Organization cloud-usage feed (docs/org-usage-feed.md). Comma-separated orgId:secret.
# The secret is 32 to 256 characters and is the bearer token. Never commit one. Unset disables the feed.
# ORG_FEED_SECRETS=swerv:replace-with-openssl-rand-hex-32
